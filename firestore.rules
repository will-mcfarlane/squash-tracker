rules_version = '2';
// Anyone with the link can view and log results. These checks only stop junk data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'color', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
        && request.resource.data.color is string
        && request.resource.data.color.matches('^#[0-9A-Fa-f]{6}$');
    }
    match /matches/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['date', 'format', 'mode', 'p1', 'p2', 'games', 'note', 'createdAt', 'editedAt'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.format is int
        && request.resource.data.format >= 1 && request.resource.data.format <= 7
        && request.resource.data.p1 is string && request.resource.data.p2 is string
        && request.resource.data.p1 != request.resource.data.p2
        && request.resource.data.games is list
        && request.resource.data.games.size() >= 1 && request.resource.data.games.size() <= 7
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 200));
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
